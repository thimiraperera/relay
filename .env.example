# Relay settings. Copy this file to .env in the app root (next to app.js), fill
# it in and protect it:   chmod 600 .env
#
# The name must be exactly ".env". cPanel File Manager hides names that start
# with a dot: tick Settings > "Show Hidden Files (dotfiles)" to see this file and
# .env. If .env is missing or unreadable, startup says so first, for example
# "could not read /home/USER/relay/.env (ENOENT)", in stderr.log.
#
# .env is the single source of settings: the web app, the hourly cron job, SSH
# sessions and cPanel "Run JS script" all read it. Keep the "Environment
# variables" list in cPanel "Setup Node.js App" EMPTY. A variable set there wins
# over .env for the web app only, so cron and the scripts would see other values.
#
# Syntax: one KEY=value per line; "#" starts a comment. Quote any value that
# contains #, spaces or quotes. Single quotes are taken literally, for example
#   DB_PASSWORD='p#ss w0rd'
# (unquoted, DB_PASSWORD=p#ss would be read as "p"). Spaces around a value are
# dropped, and $NAMES are not expanded. Restart the app after every change.
# An empty value means "use the default".


# Runtime

# "production" (the default) turns on the HTTPS-only defaults and refuses unsafe
# settings. Use "development" only on your own computer.
NODE_ENV=production

# The relay's public address: https:// plus the host, with no path.
PUBLIC_BASE_URL=https://relay.companysite.site

# Port for `npm start` on your own computer. Ignored under cPanel/LiteSpeed,
# which gives the app its own socket.
PORT=3000

# Local time zone (IANA name). It sets the day boundary for per-day limits and
# the times shown on the Logs and Stats pages and in the admin.
RELAY_TIMEZONE=Asia/Colombo


# Database (cPanel > MySQL Databases; names start with your cPanel username)

DB_HOST=localhost
DB_PORT=3306
# If the app gets "Access denied" or ECONNREFUSED over TCP (with localhost often
# reported for both ::1:3306 and 127.0.0.1:3306), connect through the MySQL
# socket instead. DB_HOST and DB_PORT are then ignored. Usually:
#   DB_SOCKET=/var/lib/mysql/mysql.sock
DB_SOCKET=
DB_NAME=cpaneluser_relay
DB_USER=cpaneluser_relay
DB_PASSWORD='change-me'
# Pool size per Node process (2-50; migrations, cleanup and master key rotation
# need two connections). LiteSpeed may run several processes, so keep the total
# well below max_user_connections (shown on Admin > System).
DB_CONNECTION_LIMIT=5
# Apply pending migrations at startup. false = run `npm run migrate` yourself
# after each upgrade (recommended, so you see the result).
AUTO_MIGRATE=false


# Secrets. Generate both with:  npm run gen-secrets

# 32 random bytes as 64 hex characters (base64 is also accepted). This key
# encrypts SMTP passwords, legacy API keys and 2FA secrets. If you lose it they
# cannot be decrypted, so back it up together with this file and separately
# from database backups. To change it, follow "Rotating the master key" in
# README.md; do not simply replace it.
MASTER_KEY=
# Set only during a master key rotation: the old key, so existing secrets still
# decrypt until `node scripts/rotate-master-key.js` has re-encrypted them.
MASTER_KEY_PREVIOUS=
# At least 32 characters. Signs the admin session cookie. Changing it signs
# every admin out.
SESSION_SECRET=


# First admin

# When both are set and no admin exists yet, this admin is created at startup.
# The password needs 12-72 bytes. Delete BOTH values and restart after the first
# sign-in; Admin > System shows a warning while they are set. Add later admins
# under Admin > Users or with `node scripts/create-admin.js <email>`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# HTTPS and proxy

# Redirect GET requests from http to https, refuse other plain-HTTP requests and
# send HSTS. Keep true in production.
FORCE_HTTPS=true
# Send the admin session cookie over HTTPS only. Keep true in production.
COOKIE_SECURE=true
# Which proxies to trust for the client IP and for HTTPS detection (Express
# "trust proxy"). 1 = one proxy hop, which is right behind Namecheap's LiteSpeed.
# A comma-separated list of proxy IPs/CIDRs (or loopback, linklocal, uniquelocal)
# also works. "true" is refused in production, because it would let any client
# fake its IP. After deploying, run the IP check on Admin > System.
TRUST_PROXY=1


# Logging

# Optional file to append log lines to, in addition to stderr (stderr.log in the
# app root on cPanel). For example /home/cpaneluser/relay/logs/relay.log. Relay
# does not rotate it. A failed start is recorded there too. If the file cannot be
# written, Relay says so on stderr ("LOG_FILE cannot be written") and logs to
# stderr only.
LOG_FILE=


# Message limits and timeouts

# Relay-wide cap for one message in bytes (1024-26214400): subject + html + text
# + the display names the caller sends + each attachment's decoded size plus
# 1024 bytes plus 6 bytes per UTF-8 byte of its filename. Each app can set a
# lower limit. The HTTP request limit is derived from it (1.4 x this + 1 MiB)
# to make room for base64.
MAX_MESSAGE_BYTES=10485760
# Timeout for each SMTP phase (DNS lookup, connect, greeting, each reply,
# inactivity) in milliseconds (1000-120000). Relay makes one connect attempt per
# send, to one address: the host's first IPv4 address, else its first IPv6.
SMTP_TIMEOUT_MS=30000
# Hard limit for one whole send, DNS lookup to final reply, in milliseconds
# (5000-300000). When it passes, the connection is closed and the send fails
# with ETIMEDOUT. If the message data had already been sent, the outcome is
# unknown and the message_id stays locked. Keep it below the clients' timeout
# (60 s recommended). Shutdown waits up to this + 10 s for sends in progress.
SMTP_SEND_DEADLINE_MS=50000
# Requests per minute per client IP on /v1/send and on /send.php (IPv6 clients
# are counted per /64).
RATE_LIMIT_IP_PER_MINUTE=120
# Default "maximum recipients per message" for new apps (1-1000). Counts unique
# to + cc + bcc addresses.
DEFAULT_MAX_RECIPIENTS=50


# Retention and time windows

# Days to keep the message log (1-3650). The cleanup job deletes older entries.
# Must be at least IDEMPOTENCY_DAYS, or the app refuses to start.
LOG_RETENTION_DAYS=90
# Days a message_id is remembered for idempotency (1-90, and at most
# LOG_RETENTION_DAYS).
IDEMPOTENCY_DAYS=7
# /send.php: largest allowed difference between X-Relay-Timestamp and the
# relay's clock, in seconds (30-3600).
LEGACY_MAX_SKEW_SECONDS=300


# Admin sessions

# Sign an admin out after this many idle minutes (5-10080) ...
SESSION_IDLE_MINUTES=120
# ... and in any case this many hours after they signed in (1-720).
SESSION_ABSOLUTE_HOURS=12


# Background cleanup

# In-process cleanup interval in minutes (0 = off, at most 10080). The host
# stops idle apps, so this only supplements the hourly cron job, which is
# required (README, "Hourly cleanup cron job").
CLEANUP_INTERVAL_MINUTES=360
