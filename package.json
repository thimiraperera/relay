{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-app HTTPS-to-SMTP mail relay with a minimal admin interface",
  "main": "app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "migrate": "node scripts/migrate.js",
